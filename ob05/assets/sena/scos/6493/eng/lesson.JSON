_override": 1}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Having Second Thoughts", "type": "lesson_name"}, {"content": "A Different Perspective", "type": "unit_name"}, {"content": 5, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 11, "type": "lesson"}, {"content": "B2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe hypothetical situations in written and spoken interactions according to work and social contexts.", "type": "primary"}, {"content": " Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_1"}, {"content": " Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_2"}, {"content": " Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_3"}, {"content": " Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_4"}, {"content": " Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_5"}, {"content": " Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_6"}, {"content": " Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_7"}, {"content": " Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. ", "type": "secondary_8"}]}, {"content": "engenn9le11ob05re1img01.jpg", "type": "background_image"}, {"type": "target_word", "contents": [{"content": "crisis", "type": "name"}, {"content": "a situation in which there are a lot of problems that must be dealt with quickly so that the situation does not get worse", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example:  I think I'm having a financial crisis!", "type": "example"}, {"content": "engenn9le11ob05aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to talk about communications. ", "type": "text"}]}, {"type": "takeaway_extension", "contents": [{"content": "Tell your partner about something you wish you had not told someone (a regret).", "type": "text"}, {"content": "Tell them what you could have or should have done instead.", "type": "text"}, {"content": "Write a 200 word description of the regret.", "type": "text"}, {"content": "Read your description aloud to a partner.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I talk about a wish in the past.", "type": "text"}, {"content": "I ask about a hypothetical situation in the past.", "type": "text"}, {"content": "I write about a wish and hypothetical situation in the past.", "type": "text"}]}, {"type": "learning_points", "contents": [{"content": "Asking for Clarification ", "type": "heading"}, {"content": "You ask for clarification when you want more details of what the other person is talking about.   </br></br>You can emphasize a point by asking rhetorical questions. ", "type": "describer"}, {"content": "You ask for clarification when it is not clear what the other person is referring to. You ask the other person to be more specific by giving you more information. ", "type": "text"}, {"content": "You can use a question at the beginning of a statement or question to ask for clarification like: <span class=\"strong\"><span class=\"italic\">Don't you think ... ?</span></span> </br>Questions within sentences are called <span class=\"strong\">embedded questions. </span>", "type": "text"}, {"content": "Example: </br><span class=\"strong\"> Simple question:</span> Who told you? </br><span class=\"strong\">Embedded question:</span> Can you remember who told you?", "type": "text"}, {"content": " Look at the chart below for an explanation on how to make embedded questions.", "type": "text"}, {"content": "{\"rows\":5,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Main Question</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Embedded Question</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Do you know ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"what/where/when/who/ ... ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Do you remember ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"what/where/when/who/ ... ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Can you tell me ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"what/where/when/who/ ... ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Could you tell me ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"what/where/when/who/ ... ?\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}, {"content": "Can you remember where you shopped last?", "type": "example"}, {"content": "Can you remember who you told?", "type": "example"}, {"content": "Anyway, do you know what I should do now? ", "type": "example"}, {"content": "Do you think that is what happened? ", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": "Talking Hypothetically About the Past", "type": "heading"}, {"content": "When you want to talk about situations in the past in a hypothetical context (not real or necessarily true), you can use the structures <span class=\"italic\">would have</span>, <span class=\"italic\">should have</span> and <span class=\"italic\">could have.</span>", "type": "describer"}, {"content": "You use <span class=\"italic\">could have</span> (+ past participle) to make a guess about something that happened in the past. ", "type": "text"}, {"content": "<span class=\"italic\">Or it <span class=\"strong\">could've happened </span> online.</span>", "type": "text"}, {"content": "<span class=\"italic\">Should have </span> (+ past participle) means something would have been a good idea, but you didn't do it. You can use it to give advice about the past when you say it to someone else, or to express regret about what you did or didn't do when you're talking about yourself.", "type": "text"}, {"content": "<span class=\"italic\">I <span class=\"strong\">shouldn't have done </span>all that online shopping. </span> (I regret doing all that online shopping).", "type": "text"}, {"content": "Use<span class=\"italic\"> would have </span> ( + past participle) to talk about something you wanted to do but didn't. This is very similar to the third conditional, but we don't need an 'if clause'.", "type": "text"}, {"content": "<span class=\"italic\">This <span class=\"strong\">would never have<span class=\"strong\"> happened.", "type": "text"}, {"content": "If you hadn't won a million dollars I would have taken you seriously the last time you made the same announcement!", "type": "example"}, {"content": " I shouldn't have done all that online shopping. ", "type": "example"}, {"content": "This would never have happened. ", "type": "example"}, {"content": " If you hadn't told so many people that you won the lottery, maybe this would not have happened.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "to make a mountain out of a molehill ", "type": "name"}, {"content": "to make a major issue out of a minor one or  to exaggerate the importance of something", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I wish you wouldn't make a mountain out of a molehill.", "type": "example"}, {"content": "engenn9le11ob05aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to swipe", "type": "name"}, {"content": "to hit or to try to hit someone or something by swinging your arm or an object very quickly", "type": "definition"}, {"content": "(verb) ", "type": "part_speech"}, {"content": "Example: All they need to do is swipe your card.", "type": "example"}, {"content": "engenn9le11ob05aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "identity theft", "type": "name"}, {"content": "a person who illicitly takes another person's identity to steal or trick", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: Do you think identity theft is what happened?", "type": "example"}, {"content": "engenn9le11ob05aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "moral support", "type": "name"}, {"content": "emotional or psychological backing", "type": "definition"}, {"content": "(noun) ", "type": "part_speech"}, {"content": "Example: Do you want to come to the police station with me for moral support?", "type": "example"}, {"content": "engenn9le11ob05aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "besides", "type": "name"}, {"content": "in addition to someone or something else that you are mentioning", "type": "definition"}, {"content": "(adverb)", "type": "part_speech"}, {"content": "Example: Besides reporting it to the credit card company and the police, there isn't much else you can do.", "type": "example"}, {"content": "engenn9le11ob05aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "holy cow", "type": "name"}, {"content": "used as an exclamation of surprise, amazement, or bewilderment", "type": "definition"}, {"content": "(expression) ", "type": "part_speech"}, {"content": "Example:   Is that your Visa bill? Holy cow!", "type": "example"}, {"content": "engenn9le11ob05aud07", "type": "audio"}]}], "type": "sena"}