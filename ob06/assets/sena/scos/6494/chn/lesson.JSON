"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": []}]}, {"stimuli_ids": [], "type": "DWS", "questions": [{"responses": [{"correct": 1, "_data": [{"type": "text", "content": ""}], "selected": 0, "id": 0}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "engenn9le11ob06re7pdf01.pdf"}]}]}], "template_override": 1, "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " Do a role play on reporting a robbery. "}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Speaking"}, {"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "<span class=\"strong\">Instructions: </span>Complete the following steps. Fill in the Self Assessment."}]}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn9le11ob06re2img05.jpg", "audiosrc": "engenn9le11ob06re2aud01", "images": [{"time": "0", "image": "engenn9le11ob06re2img05.jpg", "text": "", "id": 0}, {"time": "0", "image": "engenn9le11ob06re2img05.jpg", "text": "<span class=\"strong\">Peter</span>:  Do you know how much further it is? If I had known it was this far I'd have worn my sneakers.<br/>\n<span class=\"strong\">Sally</span>: No it's just over there. I'm really anxious about my investments.<br/>\n<span class=\"strong\">Peter</span>: Well, let see what the cops say. My feet hurt. I wish I'd put different shoes on this morning.<br/>\n<span class=\"strong\">Sally</span>: Hi, I'm here to make a report.\nPossible identity theft. I don't know but I've got this whopping huge visa bill ...", "id": 1}, {"time": "33000", "image": "engenn9le11ob06re2img01.jpg", "text": "<span class=\"strong\">Police Officer</span>: First you have to report that to Visa ma'am.<br/>\n<span class=\"strong\">Sally</span>: I did.<br/>\n<span class=\"strong\">Peter</span>: Maybe we shouldn't have come here. I kind of wish we hadn't.<br/>\n<span class=\"strong\">Police Officer</span>: Is there any other matter I can help you with?<br/>\n<span class=\"strong\">Sally</span>: Do you know if there have been cases of identity theft in this area?<br/><span class=\"strong\">Peter</span>: Don't you think we should leave now Sally!", "id": 2}, {"time": "50000", "image": "engenn9le11ob06re2img05.jpg", "text": "<span class=\"strong\">Police Officer</span>: What a pretty name.\nMay I ask why you are concerned about identity theft?<br/>\n<span class=\"strong\">Peter</span>: She won the lottery ...<br/>\n<span class=\"strong\">Sally</span>: ... and I won a million dollars. I am worried about my investments and  whoever used my Visa may have access to other information. Sometimes I wish I hadn't won the lottery.<br/>\n<span class=\"strong\">Police Officer</span>: Do you think you could go back to your bank branch and ask about any suspicious activity? <br/>\n<span class=\"strong\">Sally</span>: Yes, of course ... I wish I could make this situation disappear.<br/>\n<span class=\"strong\">Peter</span>: I wish I weren't so hungry. I wish I had eaten breakfast this morning!", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Having Second Thoughts"}, {"type": "unit_name", "content": "Hard to Tell"}, {"type": "position", "content": 6}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 11}, {"type": "level", "content": "B2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe hypothetical situations in written and spoken interactions according to work and social contexts."}, {"type": "secondary_1", "content": "Understands specific information in written texts about the different social and work contexts."}, {"type": "secondary_2", "content": "Understands specific information in written texts about the different social and work contexts."}, {"type": "secondary_3", "content": "Understands specific information in written texts about the different social and work contexts."}, {"type": "secondary_4", "content": "Understands specific information in written texts about the different social and work contexts."}, {"type": "secondary_5", "content": "Understands specific information in written texts about the different social and work contexts."}, {"type": "secondary_6", "content": "Understands specific information in written texts about the different social and work contexts."}, {"type": "secondary_7", "content": "Understands specific information in written texts about the different social and work contexts."}, {"type": "secondary_8", "content": "Understands specific information in written texts about the different social and work contexts."}]}, {"type": "background_image", "content": "engenn9le11ob06re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Talking about Wishes"}, {"type": "describer", "content": "You use <span class=\"italic\">wish</span>, plus the past form of the verb or the past participle of the verb to talk about imaginary situations in the past, present or future."}, {"type": "text", "content": "Wishes and sentences in the second and third conditional infer that what you want is probably not possible, or for some reason impossible and that you regret what happened in the past.<br/><br/>  You use <span class=\"underline\"><span class=\"italic\">wish</span> + Simple Past</span>  to talk about wishes in the present or future.<br/><br/>  For example:<br/>  <span class=\"italic\">Sometimes I <span class=\"strong\">wish I weren't</span>so hungry.</span><br/> (I am hunrgy.)"}, {"type": "text", "content": "You use <span class=\"underline\"><span class=\"italic\">wish</span> + <span class=\"italic\">had</span> + past participle</span> to talk about wishes about past situations.<br/><br/>   For example:<br/>  <span class=\"italic\">I <span class=\"strong\">wish I'd put</span> different shoes on this morning. </span><br/> (I didn't put different shoes on this morning.)"}, {"type": "example", "content": "I kind of wish we hadn't come here."}, {"type": "example", "content": " Sometimes I wish I hadn't won the lottery."}, {"type": "example", "content": " Yes of course... I wish I could make this situation disappear."}, {"type": "example", "content": " I wish I had eaten breakfast this morning!"}, {"type": "example", "content": "I wish I weren't so hungry."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Asking for Clarification"}, {"type": "describer", "content": "You ask for clarification when you want more details of what the other person is talking about.  <br/> You can emphasize a point by asking rhetorical questions."}, {"type": "text", "content": "You ask for clarification when it is not clear what the other person is referring to. You ask the other person to be more specific by giving you more information. "}, {"type": "text", "content": "You can use a question at the beginning of a statement or question to ask for clarification like: <span class=\"italic\">Don't you think ... ?</span><br/> Questions within sentences are called <span class=\"strong\">embedded questions</span>.<br/><br/>   Example: <br/> <span class=\"strong\">Simple question</span>: <span class=\"italic\">Who told you?</span><br/> <span class=\"strong\">Embedded question</span>: <span class=\"italic\">Can you remember who told you?</span><br/><br/>  Look at the chart below for an explanation on how to make embedded questions."}, {"type": "table", "content": "{\"rows\":6,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Main Question\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Embedded Question\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Do you know ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"what/where/when/who/ \u2026 ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Do you remember ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"what/where/when/who/ \u2026 ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Can you tell me ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"what/where/when/who/ \u2026 ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Could you tell me ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"what/where/when/who/ \u2026 ?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"May I ask  you ...\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"what/where/when/who/ \u2026 ?\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "Do you know if there have been cases of identity theft in this area?"}, {"type": "example", "content": " Don't you think we should leave now Sally!"}, {"type": "example", "content": " May I ask why you are concerned about identity theft?"}, {"type": "example", "content": " Do you think you could go back to your bank branch and ask about any suspicious activity? "}]}, {"type": "target_word", "contents": [{"type": "name", "content": "anxious"}, {"type": "definition", "content": "worried about something"}, {"type": "part_speech", "content": "(adjective) "}, {"type": "example", "content": "Example: I'm really anxious about my investments."}, {"type": "audio", "content": "engenn9le11ob06aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you hear when you talk about money."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "further"}, {"type": "definition", "content": "at a greater distance"}, {"type": "part_speech", "content": "(adjective) "}, {"type": "example", "content": "Example: Do you know how much further it is?"}, {"type": "audio", "content": "engenn9le11ob06aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "whopping"}, {"type": "definition", "content": "excessive; causing unexpected surprise"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: I don't know but I got this whopping huge visa bill. "}, {"type": "audio", "content": "engenn9le11ob06aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "matter"}, {"type": "definition", "content": "subject or situation"}, {"type": "part_speech", "content": "(noun) "}, {"type": "example", "content": "Example: Is there any other matter I can help you with?"}, {"type": "audio", "content": "engenn9le11ob06aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "access"}, {"type": "definition", "content": "the right to enter a place or use something"}, {"type": "part_speech", "content": "(noun) "}, {"type": "example", "content": "Example: whoever used my visa may have access to other information."}, {"type": "audio", "content": "engenn9le11ob06aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "bank branch"}, {"type": "definition", "content": "semi-independent office of a larger bank"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Do you think you could go back to your bank branch and ask about any suspicious activity?"}, {"type": "audio", "content": "engenn9le11ob06aud06"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Ask a partner if they have ever had anything taken or stolen from them."}, {"type": "text", "content": "Ask them what they would have done if it had/hadn't been returned to them."}, {"type": "text", "content": "Role play reporting the robbery/theft to the police with your partner.(include questions for clarification)"}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I ask about a situation in the past."}, {"type": "text", "content": "I ask about a hypothetical situation in the past."}, {"type": "text", "content": "I role play using questions for clarification."}]}]}